# Für lokales Testen des Scraping-Jobs (npm run scrape im Projekt-Root).
# In GitHub Actions kommen dieselben Werte aus den Actions-Secrets (siehe README.md).

# Kompletter Inhalt der Firebase-Admin-Service-Account-JSON-Datei, als eine Zeile.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
FIREBASE_PROJECT_ID=
