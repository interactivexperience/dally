# Firebase Web-App-Config (Firebase Console > Projekteinstellungen > Deine Apps)
# Diese Werte sind öffentlich sichtbar (landen im Client-Bundle) - das ist bei Firebase
# so vorgesehen, der eigentliche Schutz kommt über Firestore Security Rules (firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
